{
  "name": "interactive-dm-screen",
  "version": "1.1.0",
  "description": "Интерактивная ширма мастера — рабочий стол ведущего D&D",
  "main": "electron/main.cjs",
  "author": "Vilsonchik-Jmixus",
  "license": "MIT",
  "homepage": "https://github.com/Vilsonchik-Jmixus/interactive-dm-screen",
  "repository": {
    "type": "git",
    "url": "https://github.com/Vilsonchik-Jmixus/interactive-dm-screen.git"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "tools": "node scripts/prepare-tools.cjs",
    "build": "electron-builder --publish never"
  },
  "dependencies": {
    "electron-updater": "6.6.2",
    "tar": "7.5.23"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "electron": "45.4.1",
    "electron-builder": "26.0.12",
    "rcedit": "5.0.2"
  },
  "build": {
    "appId": "app.dm-screen.desktop",
    "productName": "Интерактивная ширма мастера",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**",
      "ui/**",
      "package.json",
      "LICENSE"
    ],
    "extraResources": [
      {
        "from": ".tools/media",
        "to": "media"
      }
    ],
    "afterPack": "scripts/after-pack.cjs",
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "DM-Screen-Setup-${version}.${ext}",
      "icon": "ui/assets/icon.ico",
      "signAndEditExecutable": false
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "artifactName": "DM-Screen-${version}-mac-${arch}.${ext}",
      "category": "public.app-category.games",
      "icon": "ui/assets/icon.png",
      "identity": null
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "artifactName": "DM-Screen-${version}-linux-${arch}.${ext}",
      "executableName": "dm-screen",
      "category": "Game",
      "maintainer": "Vilsonchik-Jmixus",
      "icon": "ui/assets/icon.png"
    },
    "appImage": {
      "executableArgs": [
        "--disable-setuid-sandbox"
      ]
    },
    "deb": {
      "recommends": [
        "ffmpeg"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Vilsonchik-Jmixus",
        "repo": "interactive-dm-screen",
        "releaseType": "release"
      }
    ]
  }
}
